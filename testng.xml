<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="All Test Suite" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    
    <test name="UI Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>
    
    <test name="API Tests">
        <classes>
            <class name="api.EmployeeApiTest"/>
        </classes>
    </test>
    
